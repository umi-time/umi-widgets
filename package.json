{
  "name": "umi-widgets",
  "version": "0.1.0",
  "description": "Official Web Components and interactive UI widgets for Umi-Time",
  "license": "MIT",
  "author": "Daniel Brannon",
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/elements/**/*.js",
    "./dist/elements/**/*.cjs",
    "./dist/**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/umi-widgets.min.js",
  "jsdelivr": "./dist/umi-widgets.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements/index.js",
      "require": "./dist/elements/index.cjs"
    },
    "./elements/umi-clock": {
      "types": "./dist/elements/umi-clock/index.d.ts",
      "import": "./dist/elements/umi-clock/index.js",
      "require": "./dist/elements/umi-clock/index.cjs"
    },
    "./elements/umi-demo-bouncing-clock": {
      "types": "./dist/elements/umi-demo-bouncing-clock/index.d.ts",
      "import": "./dist/elements/umi-demo-bouncing-clock/index.js",
      "require": "./dist/elements/umi-demo-bouncing-clock/index.cjs"
    },
    "./elements/umi-demo-world-map": {
      "types": "./dist/elements/umi-demo-world-map/index.d.ts",
      "import": "./dist/elements/umi-demo-world-map/index.js",
      "require": "./dist/elements/umi-demo-world-map/index.cjs"
    },
    "./elements/umi-display": {
      "types": "./dist/elements/umi-display/index.d.ts",
      "import": "./dist/elements/umi-display/index.js",
      "require": "./dist/elements/umi-display/index.cjs"
    },
    "./elements/umi-location": {
      "types": "./dist/elements/umi-location/index.d.ts",
      "import": "./dist/elements/umi-location/index.js",
      "require": "./dist/elements/umi-location/index.cjs"
    },
    "./elements/umi-options-menu": {
      "types": "./dist/elements/umi-options-menu/index.d.ts",
      "import": "./dist/elements/umi-options-menu/index.js",
      "require": "./dist/elements/umi-options-menu/index.cjs"
    },
    "./elements/umi-time": {
      "types": "./dist/elements/umi-time/index.d.ts",
      "import": "./dist/elements/umi-time/index.js",
      "require": "./dist/elements/umi-time/index.cjs"
    },
    "./elements/umi-time-explorer": {
      "types": "./dist/elements/umi-time-explorer/index.d.ts",
      "import": "./dist/elements/umi-time-explorer/index.js",
      "require": "./dist/elements/umi-time-explorer/index.cjs"
    },
    "./elements/umi-timeline": {
      "types": "./dist/elements/umi-timeline/index.d.ts",
      "import": "./dist/elements/umi-timeline/index.js",
      "require": "./dist/elements/umi-timeline/index.cjs"
    },
    "./elements/umi-timezones": {
      "types": "./dist/elements/umi-timezones/index.d.ts",
      "import": "./dist/elements/umi-timezones/index.js",
      "require": "./dist/elements/umi-timezones/index.cjs"
    },
    "./elements/umi-tip": {
      "types": "./dist/elements/umi-tip/index.d.ts",
      "import": "./dist/elements/umi-tip/index.js",
      "require": "./dist/elements/umi-tip/index.cjs"
    },
    "./elements/umi-tip-rotator": {
      "types": "./dist/elements/umi-tip-rotator/index.d.ts",
      "import": "./dist/elements/umi-tip-rotator/index.js",
      "require": "./dist/elements/umi-tip-rotator/index.cjs"
    },
    "./elements/umi-world-map": {
      "types": "./dist/elements/umi-world-map/index.d.ts",
      "import": "./dist/elements/umi-world-map/index.js",
      "require": "./dist/elements/umi-world-map/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "umi-time": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "happy-dom": "^17.0.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/umi-time/umi-widgets.git"
  },
  "homepage": "https://www.umitime.com/",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
