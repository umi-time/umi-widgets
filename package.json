{
  "name": "umi-widgets",
  "version": "0.1.0",
  "description": "Official Web Components and interactive UI widgets for Umi-Time",
  "license": "MIT",
  "author": "Daniel Brannon",
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/elements/*.js",
    "./dist/elements/*.cjs",
    "./dist/tokens/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/umi-widgets.min.js",
  "jsdelivr": "./dist/umi-widgets.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements/index.js",
      "require": "./dist/elements/index.cjs"
    },
    "./elements/umi-clock": {
      "types": "./dist/elements/umi-clock/index.d.ts",
      "import": "./dist/elements/umi-clock/index.js",
      "require": "./dist/elements/umi-clock/index.cjs"
    },
    "./tokens/theme.css": "./dist/tokens/theme.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "umi-time": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "happy-dom": "^17.0.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/umi-time/umi-widgets.git"
  },
  "homepage": "https://www.umitime.com/",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
